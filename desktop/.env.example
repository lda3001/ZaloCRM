# === ZaloCRM Desktop — cấu hình backend ===
# Sao chép file này thành `.env` (cùng thư mục desktop/) rồi điền giá trị thực tế.
# Electron KHÔNG đọc backend/.env — nó chỉ dùng desktop/.env này.

PORT=3000

# Chạy backend ở chế độ production (phục vụ frontend đã build từ backend/static).
NODE_ENV=production

# URL gốc dùng cho CORS / Socket.IO. Frontend được phục vụ cùng origin với backend
# nên giá trị này chủ yếu dùng để sinh link trong email/API.
APP_URL=http://localhost:3000

# BẮT BUỘC điền khi chạy production. Sinh giá trị ngẫu nhiên mạnh bằng:
#   openssl rand -hex 32
JWT_SECRET=
#   openssl rand -hex 16
ENCRYPTION_KEY=

# Kết nối PostgreSQL 16 (chạy local hoặc Docker).
DB_USER=crmuser
DB_PASSWORD=ZaloCrm2026!
DB_NAME=zalocrm
DATABASE_URL=postgresql://crmuser:ZaloCrm2026!@localhost:5432/zalocrm

# Thư mục lưu file upload.
# ĐỂ TRỐNG để tự dùng thư mục "uploads" trong userData của Electron (khuyến nghị).
# Hoặc đặt đường dẫn tuyệt đối, ví dụ: C:\Users\You\AppData\Roaming\ZaloCRM\uploads
UPLOAD_DIR=
